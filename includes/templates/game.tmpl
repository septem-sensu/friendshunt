<script type="text/javascript">
  window[ appAlias ].playerId     = '{{Game::playerId}}';
  window[ appAlias ].gameSettings = {{Gameplay::gameSettings}};
</script>

<input type="hidden" name="resetForm" value="1" />
<div id="map"></div>

<script src="includes/libs/leaflet/leaflet.js"></script>
<script src="includes/js/geoMaps.js"></script>
<script src="includes/js/batteryTracking.js"></script>
<script src="includes/js/gameplay.js"></script>
<script src="includes/js/replayPlayer.js"></script>

<div class="game-menu-top">
  <div id="game-state-icon-container" class="pointer" onclick="javascript: window[ appAlias ].methods.gameplay.checkSystemMessages();">
    <img id="icon-game-state-stop" class="icon-game-state-stop" src="includes/images/icon-stop.png" alt="Spiel läuft nicht" />
  </div>
  <div id="game-scrolling-info-text-container">
    <div id="game-scrolling-info-text"></div>
  </div>
</div>

<div class="game-menu-bottom">
  <img class="pointer icon-game-reload icons-gamplay-menu-bottom" src="includes/images/icon-reload.png" alt="Seite neu laden" onclick="javascript: window.location.reload();" />
  <img class="pointer icon-game-camera icons-gamplay-menu-bottom" src="includes/images/icon-camera.png" alt="Bild speichern" onclick="javascript: document.querySelector('#game-images-upload').click();" />
  <img id="menu-bottom-messages-button" class="pointer icon-game-message icons-gamplay-menu-bottom" src="includes/images/icon-message.png" alt="Messages" />
  <img class="icon-new-message hidden" src="includes/images/icon-new-message.png" alt="Neue Nachricht" />
  <img class="pointer icon-game-back icons-gamplay-menu-bottom" src="includes/images/icon-back.png" alt="Zurück zum Profil" onclick="javascript: window.location.href='?view=player';" />
  <input id="game-images-upload" type="file" name="pictures[]">
</div>

<div class="game-permission-pedometer">
  <h2 class="mb-20">Schrittzähler</h2>
  <p>Kein Sensor, keine Schritte, kein Ruhm im Wirtshaus! Gib bitte kurz die Bewegungssensoren frei, damit wir prüfen können, ob du wirklich rennst oder heimlich Bus fährst.</p>
  <button id="game-permission-pedometer-button" class="success mt-25">Schrittzähler aktivieren</button>
</div>

<div id="game-capture-container" class="hidden">
  <div id="game-capture-hunter-container"></div>
  <button id="game-capture-ok-button" type="button" class="danger">✔ Gefangen genommen</button>
</div>

<div id="game-system-message-container" class="hidden">
  <div id="game-system-messages"></div>
  <button id="game-system-messages-ok-button" type="button" class="success">✔ Gelesen</button>
</div>

<div id="game-message-layer" class="hidden">
  <div id="game-message-content"></div>
  <input type="text" name="new-gameplay-message" id="new-gameplay-message-input" />
  <button type="button" class="new-gameplay-message-button success" id="new-gameplay-message-button">
    <img src="includes/images/icon-message.png" />
  </button>
</div>


<div class="replay-panel hidden">
  <!-- Obere Reihe: Zeitleiste (Slider) & Uhrzeit -->
  <div class="replay-timeline-row">
    <input type="range" id="replay-slider" min="0" max="100" value="0" step="1">
    <span id="replay-clock">00:00:00</span>
  </div>

  <!-- Untere Reihe: Steuerungs-Buttons -->
  <div class="replay-controls-row">
    <div class="playback-buttons">
      <button id="btn-replay-play" class="btn-tactical">[ PLAY ]</button>
      <button id="btn-replay-pause" class="btn-tactical btn-active">[ PAUSE ]</button>
    </div>

    <div class="speed-buttons">
      <button class="btn-speed btn-active" data-speed="10">10x</button>
      <button class="btn-speed" data-speed="20">20x</button>
      <button class="btn-speed" data-speed="40">40x</button>
      <button class="btn-speed" data-speed="80">80x</button>
    </div>
  </div>
</div>

<script type="text/javascript">
  window[ appAlias ].objects.gameplay = new Gameplay( window[ appAlias ].playerId, window[ appAlias ].id, window[ appAlias ].gameSettings );
</script>

