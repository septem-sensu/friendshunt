<script type="text/javascript">
  window[ appAlias ].games      = {{Player::gameObjects}};
  window[ appAlias ].gameFields = {{Game::gameFields}};
</script>

<div class="content-container first-child" >
  <h1 class="align-left">Mein Account</h1>
</div>
<div class="content-container" >
  <h2 class="align-left">Meine Daten</h2>
  <table class="c-info-table mt-20" cellspacing="0">
    <tr>
      <td class="align-top">
        <p class="bold mb-5">{{Player::name}}</p>
        <p>{{Player::email}}</p>
        <p>{{Translate::Player::role}}</p>
        <p>{{Player::title}}</p>
        <p>{{Player::description}}</p>
        <p><button data-link="index.php?view=playerEdit" type="button" class="primary event-link mt-10 w-160">Anpassen</button></p>
        <p class="hidden" id="new-player-button-container"><button data-link="index.php?view=playerNew" type="button" class="info event-link mt-5 mb-5 w-160">Spieler anlegen</button></p>
      </td>
      <td class="align-right align-top">
        <img class="c-dashboard-player-image my-account-image" src="includes/files/player/{{Player::email}}/{{Player::image}}?v={{default::timestamp}}" />
      </td>
    </tr>
  </table>
</div>
<div class="content-container" >
  <h2 class="align-left float-left">Spiele</h2>
  <p class="align-right"><button data-link="index.php?view=gameEdit" type="button" class="event-link success w-160">Neues Spiel</button></p>
</div>
<div id="game-content-container"></div>
<script>
  window[ appAlias ].methods.unhideGameDeleteButtons = function() {
    var strRole          = '{{Player::role}}';
    var arrDeleteButtons = document.querySelectorAll( '.game-delete-button' );
    if( strRole == 'administrator' ) {
      for( var i = 0; i < arrDeleteButtons.length; i++ ) {
        arrDeleteButtons[ i ].classList.remove( 'hidden' );
      }
    }
  };
  ( function() {
    var strRole = '{{Player::role}}';
    if( strRole == 'administrator' ) {
      document.querySelector( '#new-player-button-container' ).classList.remove( 'hidden' );
    }
    window[ appAlias ].methods.cAddGamesToTemplate();
    return;
  } )();
</script>
