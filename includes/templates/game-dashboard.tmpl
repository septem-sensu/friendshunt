<button id="geo-test-btn" style="padding: 20px; font-size: 20px;">Standort freigeben</button>

<script>
document.getElementById('geo-test-btn').addEventListener('click', () => {
    console.log("Button geklickt. Starte GPS...");
    navigator.geolocation.getCurrentPosition(
        (pos) => { alert(`Erfolg! Lat: ${pos.coords.latitude}`); },
        (err) => { alert(`Fehler: ${err.message} (Code: ${err.code})`); },
        { enableHighAccuracy: true, timeout: 5000 }
    );
});
</script>
