    <div class="full-image-layer" onclick="Utils.closeFullImage();" style="display: none;"></div>
    <div class="full-image" onclick="Utils.closeFullImage();" style="display: none;"></div>
  </div>
  <script type="text/javascript">
    ( function() {
      if( 'serviceWorker' in navigator ) {
        navigator.serviceWorker.register( 'sw.js' ).then( ( objReg ) => {
          if( this.debug ) console.log( '🛰️ [PWA-RADAR]: Service Worker erfolgreich im Root registriert!', objReg );
        } ).catch( console.error );
      }
      return;
    } )();
  </script>
