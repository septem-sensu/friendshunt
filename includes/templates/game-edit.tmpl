<script src="includes/libs/leaflet/leaflet.js"></script>
<script src="includes/js/geoMaps.js"></script>

<form>
  <input type="hidden" name="resetForm" value="1" />
  <div class="content-container first-child pulse-container" >
    <h1 class="align-left float-left">Neues Game</h1>
    <div class="align-right">
      <button type="button" class="warning w-140 event-link" data-link="index.php?view=player">Zurück</button>
    </div>
  </div>

  <div class="content-container align-left pulse-container-reverse-slow">
    <h2 class="align-left mb-15">Spiel Informationen</h2>
    <label class="minw-200" for="name">Name des Spiels*</label>
    <input autocomplete="name" class="mb-10 mt-5 w-350" type="text" name="name" id="name" placeholder="Eingabe Name des Spiels" value="{{Game::name}}" />
    <label class="minw-200" for="title">Titel des Spiels*</label>
    <input autocomplete="title" class="mb-10 mt-5 w-350 suggest-game-title" title="? für einen Titel Vorschlag" type="text" name="title" id="title" placeholder="Eingabe Titel des Spiels" value="{{Game::title}}" />
    <label class="minw-200" for="description">Beschreibung</label>
    <input autocomplete="description" class="mb-10 mt-5 w-350" type="text" name="description" id="description" placeholder="Eingabe Beschreibung" value="{{Game::description}}" />
  </div>

  <div class="content-container align-left pulse-container-slow">
    <h2 class="align-left float-left mt-5">Spieler*</h2>
    <input autocomplete="search-player-field email" type="email" class="w-350 mr-10 mt-15 mb-15" name="search-player-field" id="search-player-field" />
    <p class="mb-10"><button type="button" class="event-add-player-to-game success w-180" id="event-add-player-to-game">Spieler hinzufügen</button></p>
  </div>
  <div id="game-content-container-player"></div>

  <div class="content-container align-left pulse-container-reverse">
    <h2 class="align-left float-left mt-5">Jäger*</h2>
    <input autocomplete="search-hunter-field email" type="email" class="w-350 mr-10 mt-15 mb-15" name="search-hunter-field" id="search-hunter-field" />
    <p class="mb-10"><button type="button" class="event-add-hunter-to-game success w-180" id="event-add-hunter-to-game">Jäger hinzufügen</button></p>
  </div>
  <div id="game-content-container-hunter"></div>

  <div class="content-container align-left pulse-container">
    <h2 class="align-left float-left mt-5">Spielleitung</h2>
    <input autocomplete="search-management-field email" type="email" class="w-350 mr-10 mt-15 mb-15" name="search-management-field" id="search-management-field" />
    <p class="mb-10"><button type="button" class="event-add-management-to-game success w-180" id="event-add-management-to-game">Leitung hinzufügen</button></p>
  </div>
  <div id="game-content-container-management"></div>

  <div class="content-container align-left pulse-container-reverse-slow">
    <h2 class="align-left mb-15">Spiel Einstellungen</h2>
    <label class="minw-200" for="start">Start des Spiels*</label>
    <input class="mb-10 mt-5 w-350" autocomplete="off" type="datetime-local" name="start" id="start" placeholder="Eingabe Start des Spiels" value="{{Game::start}}" />
    <label class="minw-200" for="duration">Dauer des Spiels*</label>
    <input class="mb-10 mt-5 w-350" autocomplete="off" type="number" name="duration" id="duration" value="10" placeholder="Eingabe Spieldauer in Stunden" />
    <label class="minw-200" for="trackInterval">Tracking Intervall*</label>
    <input class="mb-10 mt-5 w-350" autocomplete="off" type="number" name="trackInterval" id="trackInterval" value="60" placeholder="Eingabe Tracking Intervall in Sekunden" />
    <label class="minw-200" for="pingInterval">Silent Hunt Intervall*</label>
    <input class="mb-10 mt-5 w-350" autocomplete="off" type="number" name="pingInterval" id="pingInterval" value="60" placeholder="Eingabe Silent Hunt Interv. in Minuten" />
    <label class="minw-200" for="speedPingInterval">Speed Hunt Intervall*</label>
    <input class="mb-10 mt-5 w-350" autocomplete="off" type="number" name="speedPingInterval" id="speedPingInterval" value="120" placeholder="Eingabe Speed Hunt Interv. in Minuten" />
    <label class="minw-200" for="speedPingCount">Anzahl Speed Hunt Pings*</label>
    <input class="mb-10 mt-5 w-350" autocomplete="off" type="number" name="speedPingCount" id="speedPingCount" value="4" placeholder="Eingabe Speed Hunt Pings Anzahl" />
    <label class="minw-200" for="minimumDistancePlayer">Mindestabstand Spieler*</label>
    <input class="mb-10 mt-5 w-350" autocomplete="off" type="number" name="minimumDistancePlayer" id="minimumDistancePlayer" value="0" placeholder="Eingabe Mindestabstand Spieler in Meter" />
    <input class="hidden" type="number" name="playingFieldSize" id="playingFieldSize" placeholder="Eingabe Spielfeldgröße in Meter" value="{{Game::playingFieldSize}}" />
    <label class="minw-200" for="playingFieldCenterPosition">Spielfeld Mittelpunkt*</label>
    <input class="pointer disabled mb-10 mt-5 w-350 align-right event-open-map-layer" autocomplete="off" type="text" name="playingFieldCenterPosition" id="playingFieldCenterPosition" placeholder="Klick für den Spielfeld Mittelpunkt" value="{{Game::playingFieldCenterPosition}}" />
    <label class="minw-200" for="startPosition">Start Position*</label>
    <input class="pointer disabled mb-10 mt-5 w-350 align-right event-open-map-layer" autocomplete="off" type="text" name="startPosition" id="startPosition" placeholder="Klick für Start Position" value="{{Game::startPosition}}" />
    <label class="minw-200" for="exitPosition">Exit Position*</label>
    <input class="pointer disabled mb-10 mt-5 w-350 align-right event-open-map-layer" autocomplete="off" type="text" name="exitPosition" id="exitPosition" placeholder="Klick für Exit Position" value="{{Game::exitPosition}}" />

    <label class="minw-200" for="showPlayer">Andere Spiele anzeigen*</label>
    <select class="mb-10 mt-5 w-375 align-right" name="showPlayer" id="showPlayer">
      <option value="{{Game::showPlayer}}">{{Translate::Game::showPlayer}}</option>
      <option value="1" selected="selected">Ja</option>
      <option value="0">Nein</option>
    </select>
    <label class="minw-200" for="showNames">Spielernamen anzeigen*</label>
    <select class="mb-10 mt-5 w-375 align-right" name="showNames" id="showNames">
      <option value="1">Ja</option>
      <option value="0" selected="selected">Nein</option>
    </select>
    <label class="minw-200" for="sanctionForVehicleUse">Sanktion bei Fahrzeugnutzung (Spieler)*</label>
    <select class="mb-10 mt-5 w-375 align-right" name="sanctionForVehicleUse" id="sanctionForVehicleUse">
      <option value="1">Ja</option>
      <option value="0" selected="selected">Nein</option>
    </select>
    <label class="mw-200" for="emailInvitation">E-Mail Einladungen verschicken</label>
    <select class="mb-10 mt-5 w-375 align-right" name="emailInvitation" id="emailInvitation">
      <option value="false">Nein</option>
      <option value="true">Ja</option>
    </select>
  </div>
  <div id="game-content-container"></div>
  <div class="align-left">
    <button type="button" disabled="disabled" id="event-save-new-game" class="submit primary event-save-new-game w-140">Spiel speichern</button>
  </div>
</form>

<div id="info-layer-map" class="hidden">
  <div id="info-layer-map-close-button" class="pointer bold">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="cursor: pointer;">
      <circle cx="12" cy="12" r="10" />
      <line x1="15" y1="9" x2="9" y2="15" />
      <line x1="9" y1="9" x2="15" y2="15" />
    </svg>
  </div>
  <div id="map"></div>
</div>

