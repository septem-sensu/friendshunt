{
  "version": "0.1.0",
  "appAlias": "friends-hunt",
  "appName": "Friends-Hunt - Die Jagd beginnt",
  "cookieName": "friends-hunt",
  "defaultHost": "localhost",
  "allowedHosts": [ "localhost" ],
  "allowedOrigins": [ "http://localhost:8000" ],
  "defaultView": "login",
  "defaultLoginView": "player",
  "defaultSetupView": "setup",
  "defaultRole": "guest",
  "userClass": "Player",
  "setRole": "Player::checkLogin",
  "loginMethod": "Player::login",
  "showReplay": true,
  "passwordRules": {
    "passwordHasNumbers": true,
    "passwordHasSpecialCharacters": true,
    "passwordHasCapitalLetters": true,
    "passwordHasLowercaseLetters": true
  }
}
